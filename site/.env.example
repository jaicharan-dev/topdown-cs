# Copy this file to .env to run the site locally with accounts turned on.
#
#   cp .env.example .env
#
# .env is gitignored. These same two values live in the Cloudflare Pages
# environment settings for the deployed site, and the real environment always
# wins over this file, so having one here changes nothing about a deploy.
#
# Both are safe to keep in a local file: the anon key is designed to be public
# and is only safe because row level security is enabled. The service role key
# is NOT this, bypasses RLS entirely, and must never go anywhere near here.
#
# Find both in the Supabase dashboard under Project Settings -> API.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
